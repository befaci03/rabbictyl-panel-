<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RabbiCtyl.Addon.EggBanners</AssemblyName>
    <RootNamespace>RabbiCtyl.Addon.EggBanners</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- Built straight into the addon folder the panel scans at runtime. -->
    <OutputPath>../../addons/egg_banners/lib/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RabbiCtyl.Addons.Abstractions\RabbiCtyl.Addons.Abstractions.csproj" />
  </ItemGroup>

</Project>
