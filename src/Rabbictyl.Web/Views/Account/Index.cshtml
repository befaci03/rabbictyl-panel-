@model AccountViewModel
@{
    ViewData["Title"] = L["account.title"].ToString();
}

<section class="page">
    <header class="page__header">
        <div>
            <span class="eyebrow">@L["account.eyebrow"]</span>
            <h1 class="page__title">@L["account.title"]</h1>
            <p class="page__subtitle">@L["account.subtitle"]</p>
        </div>
        <span class="badge @(Model.User.IsRootAdmin ? "badge--running" : null)">
            @(Model.User.IsRootAdmin ? L["role.admin"] : L["role.member"])
        </span>
    </header>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert--success" role="status">@success</div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert--danger" role="alert">@error</div>
    }

    <div class="server-layout">
        <section class="card">
            <div class="card__header">
                <div>
                    <h2 class="card__title">@L["account.password"]</h2>
                    <p class="card__subtitle">@L["account.passwordHint"]</p>
                </div>
            </div>
            <form method="post" asp-controller="Account" asp-action="ChangePassword" class="form">
                <div class="form__group">
                    <label class="form__label" for="current-password">@L["account.currentPassword"]</label>
                    <input class="form__input" id="current-password" name="CurrentPassword" type="password" autocomplete="current-password" required />
                </div>
                <div class="form__group">
                    <label class="form__label" for="new-password">@L["account.newPassword"]</label>
                    <input class="form__input" id="new-password" name="NewPassword" type="password" autocomplete="new-password" required minlength="8" />
                </div>
                <div class="form__group">
                    <label class="form__label" for="new-password-confirm">@L["account.newPasswordConfirm"]</label>
                    <input class="form__input" id="new-password-confirm" name="NewPasswordConfirmation" type="password" autocomplete="new-password" required minlength="8" />
                </div>
                <div class="admin-create__actions">
                    <button type="submit" class="button button--primary">@L["account.updatePassword"]</button>
                </div>
            </form>
        </section>

        <aside class="stack">
            <section class="card">
                <div class="card__header">
                    <div>
                        <h2 class="card__title">@L["account.profile"]</h2>
                        <p class="card__subtitle">@L["account.profileHint"]</p>
                    </div>
                </div>
                <dl class="detail-list">
                    <div><dt>@L["account.username"]</dt><dd>@Model.User.Username</dd></div>
                    <div>
                        <dt>@L["account.email"]</dt>
                        <dd><span class="email-mask" tabindex="0" title="@L["account.revealEmail"]">@Model.User.Email</span></dd>
                    </div>
                    <div><dt>@L["account.name"]</dt><dd>@Model.User.DisplayName</dd></div>
                </dl>
            </section>
        </aside>
    </div>

    <section class="card">
        <div class="card__header">
            <div>
                <h2 class="card__title">@L["account.sshTitle"]</h2>
                <p class="card__subtitle">@L["account.sshHint"]</p>
            </div>
            <span class="pill pill--muted">@Model.SshKeys.Count</span>
        </div>

        @if (Model.SshKeys.Count == 0)
        {
            <p class="form__hint">@L["account.sshEmpty"]</p>
        }
        else
        {
            <ul class="key-list">
                @foreach (var key in Model.SshKeys)
                {
                    var parts = key.Split(' ', 2, StringSplitOptions.RemoveEmptyEntries);
                    <li class="key-list__item">
                        <code class="key-list__value">@parts[0] …@(parts.Length > 1 ? parts[1][^12..] : string.Empty)</code>
                        <form method="post" asp-controller="Account" asp-action="RemoveSshKey" class="inline-form">
                            <input type="hidden" name="key" value="@key" />
                            <button type="submit" class="button button--ghost button--sm">@L["account.sshRemove"]</button>
                        </form>
                    </li>
                }
            </ul>
        }

        <form method="post" asp-controller="Account" asp-action="AddSshKey" class="form">
            <div class="form__group">
                <label class="form__label" for="ssh-key">@L["account.sshAdd"]</label>
                <textarea class="form__input" id="ssh-key" name="Key" rows="3" spellcheck="false" placeholder="ssh-ed25519 AAAAC3Nza... user@host" required></textarea>
            </div>
            <div class="admin-create__actions">
                <button type="submit" class="button button--primary">@L["account.sshAddSubmit"]</button>
            </div>
        </form>
    </section>
</section>
