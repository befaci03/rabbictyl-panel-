@model ResetPasswordViewModel
@{
    Layout = await ThemeLayouts.ResolveAsync(Context, auth: true);
    ViewData["Title"] = L["reset.title"].ToString();
}

<section class="auth">
    <div class="auth__shell">
        <aside class="auth__aside">
            <div class="auth__aside-top">
                <partial name="_BrandMark" />
                <span class="brand__text">
                    <span class="brand__name">@Branding.Current.Name</span>
                    <span class="brand__sub">@L["brand.subtitle"]</span>
                </span>
            </div>

            <div class="auth__aside-copy">
                <span class="eyebrow">@L["reset.eyebrow"]</span>
                <h1>@L["reset.asideTitle"]</h1>
                <p>@L["reset.asideText"]</p>
            </div>

            <span class="auth__aside-foot">@Branding.Current.Name panel</span>
        </aside>

        <div class="auth__form-side">
            <div class="auth__form-inner">
                <span class="eyebrow">@L["reset.eyebrow"]</span>
                <h2 class="auth__title">@L["reset.title"]</h2>
                <p class="auth__subtitle">@L["reset.subtitle"]</p>

                <form method="post" asp-controller="Auth" asp-action="ResetPassword" class="form">
                    <div asp-validation-summary="ModelOnly" class="alert alert--danger"></div>

                    <input asp-for="Email" type="hidden" />
                    <input asp-for="Token" type="hidden" />

                    <div class="form__group">
                        <label asp-for="Password" class="form__label">@L["reset.password"]</label>
                        <input asp-for="Password" class="form__input" autocomplete="new-password" autofocus />
                        <span asp-validation-for="Password" class="form__error"></span>
                    </div>

                    <div class="form__group">
                        <label asp-for="PasswordConfirmation" class="form__label">@L["reset.passwordConfirm"]</label>
                        <input asp-for="PasswordConfirmation" class="form__input" autocomplete="new-password" />
                        <span asp-validation-for="PasswordConfirmation" class="form__error"></span>
                    </div>

                    <button type="submit" class="button button--primary button--block">@L["reset.submit"]</button>
                </form>

                <p class="auth__note">
                    <a asp-controller="Auth" asp-action="Login">@L["forgot.back"]</a>
                </p>
            </div>
        </div>
    </div>
</section>
