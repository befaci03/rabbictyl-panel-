@model RegisterViewModel
@inject ICaptchaVerifier Captcha
@{
    Layout = await ThemeLayouts.ResolveAsync(Context, auth: true);
    ViewData["Title"] = "Create account";
}

<section class="auth">
    <div class="auth__shell">
        <aside class="auth__aside">
            <div class="auth__aside-top">
                <partial name="_BrandMark" />
                <span class="brand__text">
                    <span class="brand__name">@Branding.Current.Name</span>
                </span>
            </div>

            <div class="auth__aside-copy">
                <span class="eyebrow">@L["register.eyebrow"]</span>
                <h1>@L["register.asideTitle"]</h1>
                <p>@L["register.asideText"]</p>
            </div>

            <span class="auth__aside-foot">@Branding.Current.Name panel</span>
        </aside>

        <div class="auth__form-side">
            <div class="auth__form-inner">
                <span class="eyebrow">@L["register.eyebrow"]</span>
                <h2 class="auth__title">@L["register.title"]</h2>
                <p class="auth__subtitle">@L["register.subtitle"]</p>

                <form method="post" asp-controller="Auth" asp-action="Register" class="form">
                    <div asp-validation-summary="ModelOnly" class="alert alert--danger"></div>

                    <div class="form__grid">
                        <div class="form__group">
                            <label asp-for="FirstName" class="form__label">@L["register.firstName"]</label>
                            <input asp-for="FirstName" class="form__input" autocomplete="given-name" autofocus />
                            <span asp-validation-for="FirstName" class="form__error"></span>
                        </div>
                        <div class="form__group">
                            <label asp-for="LastName" class="form__label">@L["register.lastName"]</label>
                            <input asp-for="LastName" class="form__input" autocomplete="family-name" />
                            <span asp-validation-for="LastName" class="form__error"></span>
                        </div>
                    </div>

                    <div class="form__group">
                        <label asp-for="Username" class="form__label">@L["register.username"]</label>
                        <input asp-for="Username" class="form__input" autocomplete="username" />
                        <span asp-validation-for="Username" class="form__error"></span>
                    </div>

                    <div class="form__group">
                        <label asp-for="Email" class="form__label">@L["register.email"]</label>
                        <input asp-for="Email" class="form__input" type="email" autocomplete="email" />
                        <span asp-validation-for="Email" class="form__error"></span>
                    </div>

                    <div class="form__group">
                        <label asp-for="Password" class="form__label">@L["register.password"]</label>
                        <input asp-for="Password" class="form__input" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="form__error"></span>
                    </div>

                    <div class="form__group">
                        <label asp-for="PasswordConfirmation" class="form__label">@L["register.passwordConfirm"]</label>
                        <input asp-for="PasswordConfirmation" class="form__input" autocomplete="new-password" />
                        <span asp-validation-for="PasswordConfirmation" class="form__error"></span>
                    </div>

                    @if (Captcha.Required)
                    {
                        <div class="form__group captcha" data-captcha-provider="@Captcha.Provider">
                            <span class="form__label">@L["captcha.label"]</span>
                            <input type="hidden" asp-for="CaptchaToken" data-captcha-token />
                            @if (Captcha.Provider == "hcaptcha")
                            {
                                <div class="h-captcha" data-sitekey="@Captcha.SiteKey" data-callback="rabbictylCaptchaSolved"></div>
                            }
                            else
                            {
                                <div class="cf-turnstile" data-sitekey="@Captcha.SiteKey" data-callback="rabbictylCaptchaSolved"></div>
                            }
                            <span class="form__hint">@L["captcha.hint"]</span>
                        </div>
                    }

                    <button type="submit" class="button button--primary button--block">@L["register.submit"]</button>
                </form>

                <p class="auth__note">
                    @L["register.haveAccount"]
                    <a asp-controller="Auth" asp-action="Login">@L["login.submit"]</a>
                </p>

                @if (Captcha.Required)
                {
                    <script>
                        function rabbictylCaptchaSolved(token) {
                            var field = document.querySelector('[data-captcha-token]');
                            if (field) {
                                field.value = token;
                            }
                        }
                    </script>
                    if (Captcha.Provider == "hcaptcha")
                    {
                        <script src="https://js.hcaptcha.com/1/api.js" async defer></script>
                    }
                    else
                    {
                        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
                    }
                }
            </div>
        </div>
    </div>
</section>
