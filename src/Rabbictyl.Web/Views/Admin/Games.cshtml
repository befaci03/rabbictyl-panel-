@model AdminNestsViewModel
@{
    ViewData["Title"] = L["admin.games"].ToString();
    var tab = Model.Tab;

    string TabClass(string name) => string.Equals(tab, name, StringComparison.OrdinalIgnoreCase)
        ? "tab is-active"
        : "tab";
}

<section class="page">
    <header class="page__header">
        <div>
            <span class="eyebrow">@L["admin.eyebrow"]</span>
            <h1 class="page__title">@L["admin.games"]</h1>
            <p class="page__subtitle">@L["admin.games.subtitle"]</p>
        </div>
        <a class="button button--primary" asp-controller="Admin" asp-action="GameNew">@L["admin.games.create"]</a>
    </header>

    <partial name="_AdminTabs" />

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert--success" role="status">@success</div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert--danger" role="alert">@error</div>
    }

    @Html.AntiForgeryToken()

    <nav class="tabs" aria-label="@L["admin.games"]">
        <a class="@TabClass("eggs")" asp-controller="Admin" asp-action="Games" asp-route-tab="eggs">
            @L["admin.games.tab.eggs"] · @Model.EggCount
        </a>
        <a class="@TabClass("import")" asp-controller="Admin" asp-action="Games" asp-route-tab="import">@L["admin.games.tab.import"]</a>
        <a class="@TabClass("files")" asp-controller="Admin" asp-action="Games" asp-route-tab="files">@L["admin.games.tab.files"]</a>
    </nav>

    @if (tab == "import")
    {
        <section class="card">
            <h2 class="card__title">@L["admin.games.import"]</h2>
            <p class="form__hint">@L["admin.games.importHint"]</p>

            <div class="admin-create__grid">
                <div class="form__group">
                    <label class="form__label" for="nest-import-url">@L["admin.games.importSingle"]</label>
                    <input class="form__input" id="nest-import-url" type="url" placeholder="https://example.com/nests/minecraft-paper.toml" />
                </div>
                <div class="form__group">
                    <label class="form__label" for="nest-import-urls">@L["admin.games.importBulk"]</label>
                    <textarea class="form__input" id="nest-import-urls" rows="4" spellcheck="false" placeholder='["https://example.com/nests/a.toml","https://example.com/nests/b.toml"]'></textarea>
                    <span class="form__hint">@L["admin.games.importBulkHint"]</span>
                </div>
            </div>

            <div class="admin-create__actions">
                <span class="form__hint" id="nest-import-error" role="alert" style="margin-right:auto;"></span>
                <button type="button" class="button button--primary" id="nest-import-preview">@L["admin.games.importPreview"]</button>
            </div>
        </section>

        <div id="nest-import-modal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.55); z-index:1000; padding:16px; align-items:center; justify-content:center;">
            <div class="card" style="width:min(720px,100%); max-height:88vh; overflow:auto;">
                <div class="card__header" style="display:flex; align-items:center; justify-content:space-between; gap:12px;">
                    <h2 class="card__title">@L["admin.games.import"]</h2>
                    <button type="button" class="button button--ghost button--sm" id="nest-import-close">@L["admin.games.close"]</button>
                </div>
                <div class="alert alert--warning" id="nest-import-warnings" role="alert" style="margin-top:8px; display:none;"></div>
                <div id="nest-import-list" style="display:grid; gap:8px; margin-top:12px;"></div>
                <div id="nest-import-progress" style="display:none; margin-top:14px;">
                    <span class="form__hint" id="nest-import-progress-text">@L["admin.games.importing"]</span>
                    <div style="height:8px; border-radius:999px; background:rgba(127,127,127,.25); margin-top:6px; overflow:hidden;">
                        <div id="nest-import-progress-bar" style="height:100%; width:0%; background:var(--accent); transition:width .2s;"></div>
                    </div>
                </div>
                <div class="admin-create__actions" style="display:flex; gap:8px; margin-top:16px;">
                    <button type="button" class="button button--primary" id="nest-import-continue" style="display:none;">@L["admin.games.importContinue"]</button>
                    <button type="button" class="button button--primary" id="nest-import-done" style="display:none;">@L["admin.games.refresh"]</button>
                    <button type="button" class="button button--ghost" id="nest-import-cancel">@L["admin.games.cancel"]</button>
                </div>
            </div>
        </div>
    }
    else if (tab == "files")
    {
        <section class="card">
            <h2 class="card__title">@L["admin.games.tab.files"]</h2>
            <p class="form__hint">@L["admin.games.filesHint"]</p>
            <div id="nest-files" style="display:grid; gap:8px;"></div>
            <span class="form__hint" id="nest-files-error" role="alert"></span>
        </section>
    }
    else
    {
        <p class="form__hint">@L["admin.games.nestHint"]</p>

        @if (Model.Nests.Count == 0)
        {
            <div class="card empty">
                <p class="empty__title">@L["admin.games.empty"]</p>
                <p class="empty__hint">@L["admin.games.emptyHint"]</p>
            </div>
        }
        else
        {
            <div class="nest-toolbar">
                <div class="form__group">
                    <label class="form__label" for="nest-search">@L["admin.games.search"]</label>
                    <input class="form__input" id="nest-search" type="search" autocomplete="off"
                           placeholder="@L["admin.games.searchHint"]" />
                </div>
                <div class="form__group">
                    <label class="form__label" for="nest-filter">@L["admin.games.filter"]</label>
                    <select class="form__input" id="nest-filter">
                        <option value="">@L["admin.games.allNests"]</option>
                        @foreach (var nest in Model.Nests)
                        {
                            <option value="@(nest.FromNest ? nest.Id : "__panel")">
                                @(nest.FromNest ? nest.Name : L["admin.games.panelGroup"]) (@nest.EggCount)
                            </option>
                        }
                    </select>
                </div>
                <span class="form__hint nest-toolbar__count" id="nest-filter-count" aria-live="polite"></span>
            </div>

            <div class="card empty" id="nest-no-matches" hidden>
                <p class="empty__title">@L["admin.games.noMatches"]</p>
                <p class="empty__hint">@L["admin.games.noMatchesHint"]</p>
            </div>

            @foreach (var nest in Model.Nests)
            {
                <details class="card nest-group" open data-nest="@(nest.FromNest ? nest.Id : "__panel")">
                    <summary class="nest-group__head">
                        <span class="nest-group__titles">
                            <span class="nest-group__title">@(nest.FromNest ? nest.Name : L["admin.games.panelGroup"])</span>
                            <span class="nest-group__meta">
                                @if (nest.FromNest)
                                {
                                    <code>@nest.Id</code>
                                    @if (!string.IsNullOrWhiteSpace(nest.Version))
                                    {
                                        <span>v@(nest.Version)</span>
                                    }
                                }
                                <span>@L["admin.games.eggCount"] · @nest.EggCount</span>
                                @if (nest.EditedAt is { } editedAt)
                                {
                                    <span>@L["admin.games.edited"] @editedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                                }
                            </span>
                        </span>
                    </summary>

                    <div class="nest-eggs">
                        @foreach (var template in nest.Eggs)
                        {
                            var egg = template.Egg;
                            var images = EggTemplate.ImageChoices(egg);
                            var variables = EggTemplate.Variables(egg);
                            var search = string.Join(' ', new[]
                            {
                                egg.Name,
                                egg.Description ?? string.Empty,
                                template.NestName ?? L["admin.games.panelGroup"],
                                egg.Uuid.ToString(),
                                string.Join(' ', images.Select(choice => $"{choice.Key} {choice.Value}")),
                            }).ToLowerInvariant();

                            <div class="nest-egg" data-search="@search">
                                <div class="nest-egg__main">
                                    <a class="nest-egg__name"
                                       asp-controller="Admin" asp-action="GameEdit" asp-route-uuid="@egg.Uuid">@egg.Name</a>
                                    <span class="nest-egg__desc">@(string.IsNullOrWhiteSpace(egg.Description) ? egg.Uuid.ToString() : egg.Description)</span>
                                    @if (template.FromNest && template.EditedAt is not null)
                                    {
                                        <span class="badge badge--starting">@L["admin.games.panelCopy"]</span>
                                    }
                                </div>

                                <div class="nest-egg__images">
                                    @foreach (var choice in images.Take(2))
                                    {
                                        <span class="chip chip--image" title="@choice.Value">
                                            @(string.Equals(choice.Key, "default", StringComparison.Ordinal) ? L["admin.games.defaultImage"] : choice.Key)
                                        </span>
                                    }
                                    @if (images.Count > 2)
                                    {
                                        <span class="chip chip--more" title="@string.Join("\n", images.Skip(2).Select(choice => choice.Value))">
                                            +@(images.Count - 2)
                                        </span>
                                    }
                                </div>

                                <span class="nest-egg__stat">@L["admin.games.variablesCount"] · @variables.Count</span>

                                <div class="nest-egg__actions">
                                    <a class="button button--ghost button--sm"
                                       asp-controller="Admin" asp-action="GameEdit" asp-route-uuid="@egg.Uuid">@L["admin.games.edit"]</a>

                                    @if (template.EditedAt is not null)
                                    {
                                        <form method="post"
                                              asp-controller="Admin"
                                              asp-action="DeleteGame"
                                              asp-route-uuid="@egg.Uuid"
                                              class="inline-form nest-delete"
                                              data-confirm="@(template.FromNest ? L["admin.games.resetConfirm"] : L["admin.games.deleteConfirm"])">
                                            <button type="submit" class="button button--ghost button--sm">
                                                @(template.FromNest ? L["admin.games.reset"] : L["admin.games.delete"])
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </details>
            }
        }
    }

    <script>
        (() => {
            "use strict";

            const token = () => document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";

            async function post(url, body) {
                const response = await fetch(url, {
                    method: "POST",
                    headers: { "Content-Type": "application/json", "X-CSRF-TOKEN": token() },
                    body: JSON.stringify(body),
                });
                const data = await response.json().catch(() => ({}));
                if (!response.ok) {
                    throw new Error(data.error || `Request failed (HTTP ${response.status})`);
                }
                return data;
            }

            document.addEventListener("submit", (event) => {
                const form = event.target.closest(".nest-delete");
                if (form && form.dataset.confirm && !window.confirm(form.dataset.confirm)) {
                    event.preventDefault();
                }
            });

            // Nest import: preview → confirm → streamed writes.
            const modal = document.getElementById("nest-import-modal");
            const list = document.getElementById("nest-import-list");

            if (modal && list) {
                const warnings = document.getElementById("nest-import-warnings");
                const error = document.getElementById("nest-import-error");
                const continueButton = document.getElementById("nest-import-continue");
                const doneButton = document.getElementById("nest-import-done");
                const progress = document.getElementById("nest-import-progress");
                const progressText = document.getElementById("nest-import-progress-text");
                const progressBar = document.getElementById("nest-import-progress-bar");

                let batchId = null;
                let stream = null;
                let rows = [];
                let total = 0;
                let finished = 0;

                function showWarnings(message) {
                    warnings.textContent = message;
                    warnings.style.display = message ? "" : "none";
                }

                function closeModal() {
                    modal.style.display = "none";
                    if (stream) {
                        stream.close();
                        stream = null;
                    }
                }

                function renderRows(items) {
                    list.innerHTML = "";
                    rows = items.map((item) => {
                        const row = document.createElement("div");
                        row.style.cssText = "border:1px solid rgba(127,127,127,.3); border-radius:8px; padding:10px 12px; display:flex; gap:10px; align-items:flex-start;";

                        const badge = document.createElement("span");
                        badge.className = "badge";
                        badge.textContent = item.ok ? "ready" : "error";

                        const body = document.createElement("div");
                        const url = document.createElement("div");
                        url.style.cssText = "font-weight:600; word-break:break-all;";
                        url.textContent = item.url;

                        const meta = document.createElement("div");
                        meta.className = "form__hint";
                        meta.style.margin = "0";
                        meta.textContent = item.ok
                            ? `${item.nestId || "(no id)"} · ${item.eggCount} egg(s): ${(item.eggs || []).join(", ")} → nests/${item.targetFile}`
                                + (item.conflict ? " · replaces an existing file" : "")
                                + (item.duplicate ? " · same target as another URL in this batch" : "")
                            : (item.error || "Could not load this URL");

                        body.append(url, meta);
                        row.append(badge, body);
                        list.append(row);

                        return { badge, meta, state: item.ok ? "ready" : "error" };
                    });
                }

                async function preview() {
                    error.textContent = "";
                    showWarnings("");
                    continueButton.style.display = "none";
                    doneButton.style.display = "none";
                    progress.style.display = "none";

                    const bulk = document.getElementById("nest-import-urls").value.trim();
                    const single = document.getElementById("nest-import-url").value.trim();
                    let urls = [];

                    if (bulk) {
                        try {
                            const parsed = JSON.parse(bulk);
                            if (!Array.isArray(parsed) || parsed.some((entry) => typeof entry !== "string")) {
                                throw new Error("not an array of strings");
                            }
                            urls = parsed.map((entry) => entry.trim()).filter(Boolean);
                        } catch {
                            error.textContent = 'Bulk import expects a JSON array of URL strings, e.g. ["https://…/nest.toml"].';
                            return;
                        }
                    }

                    if (single) {
                        urls.push(single);
                    }

                    urls = [...new Set(urls)];

                    if (urls.length === 0) {
                        error.textContent = "Enter a URL or paste a JSON array of URLs.";
                        return;
                    }

                    modal.style.display = "flex";
                    list.innerHTML = `<div class="form__hint">Fetching and checking ${urls.length} URL(s)…</div>`;

                    try {
                        const data = await post("/admin/games/import/preview", { urls });
                        batchId = data.batchId;
                        showWarnings((data.warnings || []).join(" "));
                        renderRows(data.items || []);
                        total = (data.items || []).filter((item) => item.ok).length;

                        if (total > 0) {
                            continueButton.style.display = "";
                        } else {
                            showWarnings("None of these URLs could be imported. " + (data.warnings || []).join(" "));
                        }
                    } catch (exception) {
                        list.innerHTML = "";
                        showWarnings(exception.message);
                    }
                }

                function beginStream(jobId) {
                    finished = 0;
                    progress.style.display = "";
                    progressText.textContent = `Importing 0 / ${total}…`;
                    progressBar.style.width = "0%";

                    stream = new EventSource(`/admin/games/import/stream?jobId=${encodeURIComponent(jobId)}`);

                    stream.addEventListener("item", (event) => {
                        const item = JSON.parse(event.data);
                        const row = rows[item.index];

                        if (!row) {
                            return;
                        }

                        row.badge.textContent = item.state;
                        row.badge.className = item.state === "done"
                            ? "badge badge--running"
                            : item.state === "failed"
                                ? "badge badge--stopping"
                                : "badge badge--starting";
                        row.meta.textContent = item.detail || row.meta.textContent;

                        if (item.state === "done" || item.state === "failed") {
                            finished += 1;
                            progressText.textContent = `Imported ${finished} / ${total}…`;
                            progressBar.style.width = `${Math.round((finished / Math.max(total, 1)) * 100)}%`;
                        }
                    });

                    stream.addEventListener("done", (event) => {
                        const data = JSON.parse(event.data);
                        stream.close();
                        stream = null;
                        progressText.textContent = `Finished: ${data.imported} imported, ${data.failed} failed.`;
                        progressBar.style.width = "100%";
                        doneButton.style.display = "";
                    });

                    stream.addEventListener("error", (event) => {
                        // Server-sent `error` events carry data; transport hiccups do not.
                        if (event.data) {
                            const data = JSON.parse(event.data);
                            showWarnings(data.message || "The import reported an error.");
                        }
                    });
                }

                async function startImport() {
                    if (!batchId) {
                        return;
                    }

                    continueButton.style.display = "none";
                    showWarnings("");

                    try {
                        const data = await post("/admin/games/import/start", { batchId });
                        beginStream(data.jobId);
                    } catch (exception) {
                        showWarnings(exception.message);
                        continueButton.style.display = "";
                    }
                }

                document.getElementById("nest-import-preview").addEventListener("click", preview);
                continueButton.addEventListener("click", startImport);
                doneButton.addEventListener("click", () => window.location.reload());
                document.getElementById("nest-import-cancel").addEventListener("click", closeModal);
                document.getElementById("nest-import-close").addEventListener("click", closeModal);
                modal.addEventListener("click", (event) => {
                    if (event.target === modal) {
                        closeModal();
                    }
                });
                document.addEventListener("keydown", (event) => {
                    if (event.key === "Escape" && modal.style.display !== "none") {
                        closeModal();
                    }
                });
            }

            // Nest files on disk.
            const files = document.getElementById("nest-files");

            if (files) {
                const fileError = document.getElementById("nest-files-error");

                function fileRow(file) {
                    const item = document.createElement("div");
                    item.style.cssText = "border:1px solid rgba(127,127,127,.3); border-radius:8px; padding:10px 12px; display:flex; gap:10px; align-items:center; justify-content:space-between;";

                    const body = document.createElement("div");
                    const title = document.createElement("div");
                    title.style.fontWeight = "600";
                    title.textContent = file.file;
                    const meta = document.createElement("div");
                    meta.className = "form__hint";
                    meta.style.margin = "0";
                    meta.textContent = file.error
                        ? `Unreadable: ${file.error}`
                        : `${file.nestId || "(no id)"} · ${file.nestName || ""} · version ${file.version || "—"} · ${file.eggCount} egg(s)`;

                    body.append(title, meta);

                    const button = document.createElement("button");
                    button.type = "button";
                    button.className = "button button--ghost button--sm";
                    button.textContent = "Delete";
                    button.addEventListener("click", async () => {
                        if (!window.confirm(`Delete nests/${file.file}?\n\nIts eggs disappear from the panel. Servers created from it keep running.`)) {
                            return;
                        }

                        fileError.textContent = "";
                        button.disabled = true;

                        try {
                            await post("/admin/games/nests/delete", { file: file.file });
                            await loadFiles();
                        } catch (exception) {
                            fileError.textContent = exception.message;
                            button.disabled = false;
                        }
                    });

                    item.append(body, button);
                    return item;
                }

                async function loadFiles() {
                    fileError.textContent = "";

                    try {
                        const response = await fetch("/admin/games/nests/list", { headers: { "Accept": "application/json" } });
                        if (!response.ok) {
                            throw new Error(`Request failed (HTTP ${response.status})`);
                        }

                        const data = await response.json();
                        files.innerHTML = "";

                        if (!data.nests || data.nests.length === 0) {
                            files.innerHTML = '<div class="form__hint">No nest files found in the nests folder.</div>';
                            return;
                        }

                        data.nests.forEach((file) => files.append(fileRow(file)));
                    } catch (exception) {
                        fileError.textContent = exception.message;
                    }
                }

                loadFiles();
            }
        })();
    </script>

    <script>
        // Client-side egg search and nest filter: no round-trip, the groups stay
        // rendered and only the rows that match are shown.
        (() => {
            "use strict";

            const search = document.getElementById("nest-search");
            const filter = document.getElementById("nest-filter");
            const groups = [...document.querySelectorAll("[data-nest]")];
            const count = document.getElementById("nest-filter-count");
            const empty = document.getElementById("nest-no-matches");

            if (!search || !filter || groups.length === 0) {
                return;
            }

            const rows = groups.map((group) => [...group.querySelectorAll(".nest-egg")]);
            const total = rows.reduce((sum, list) => sum + list.length, 0);

            function apply() {
                const term = search.value.trim().toLowerCase();
                const nest = filter.value;
                let visible = 0;

                groups.forEach((group, index) => {
                    const nestMatches = !nest || group.dataset.nest === nest;
                    let groupVisible = 0;

                    rows[index].forEach((row) => {
                        const matches = !term || (row.dataset.search || "").includes(term);
                        const show = nestMatches && matches;
                        row.hidden = !show;

                        if (show) {
                            groupVisible += 1;
                        }
                    });

                    group.hidden = groupVisible === 0;
                    visible += groupVisible;

                    if (term || nest) {
                        group.open = groupVisible > 0;
                    }
                });

                empty.hidden = visible !== 0;
                count.textContent = term || nest ? `${visible} / ${total}` : "";
            }

            search.addEventListener("input", apply);
            filter.addEventListener("change", apply);
        })();
    </script>
</section>
