@model IReadOnlyList<AddonDescriptor>
@using Rabbictyl.Infrastructure.Extensions
@inject AddonHost AddonHost
@{
    ViewData["Title"] = "Addons";
}

<section class="page">
    <header class="page__header">
        <div>
            <span class="eyebrow">@L["admin.eyebrow"]</span>
            <h1 class="page__title">@L["admin.addons"]</h1>
            <p class="page__subtitle">Extensions installed in the panel's addon folder.</p>
        </div>
    </header>

    <partial name="_AdminTabs" />

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert--success" role="status">@success</div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert--danger" role="alert">@error</div>
    }

    @if (TempData["Notice"] is string notice)
    {
        <div class="alert" role="status">@notice</div>
    }

    @if (Model.Count == 0)
    {
        <div class="card empty">
            <p class="empty__title">No addons installed</p>
            <p class="empty__hint">Add a folder with a manifest.json to the addons directory.</p>
        </div>
    }
    else
    {
        <div class="addon-grid">
            @foreach (var addon in Model)
            {
                var settingsTab = AddonHost.AdminTabs.FirstOrDefault(tab =>
                    string.Equals(tab.AddonId, addon.Id, StringComparison.OrdinalIgnoreCase));
                <article class="addon-card card">
                    <div class="addon-card__top">
                        <span class="addon-card__icon">
                            @if (addon.AssetUrls.TryGetValue("icon", out var iconUrl))
                            {
                                <img src="@iconUrl" alt="" width="22" height="22" />
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                                    <path d="M9 4.5h6a1.5 1.5 0 0 1 1.5 1.5v2H17a2 2 0 0 1 2 2v2h-2.5a1.5 1.5 0 0 0 0 3H19v2a2 2 0 0 1-2 2h-3.5v-2.5a1.5 1.5 0 0 0-3 0V19H7a2 2 0 0 1-2-2v-3.5h2.5a1.5 1.5 0 0 0 0-3H5V8a2 2 0 0 1 2-2h.5V6A1.5 1.5 0 0 1 9 4.5Z" />
                                </svg>
                            }
                        </span>
                        @if (addon.IsEnabled)
                        {
                            <span class="badge badge--running">Enabled</span>
                        }
                        else
                        {
                            <span class="badge">Disabled</span>
                        }
                    </div>
                    <h2 class="addon-card__name">@addon.Name</h2>
                    <p class="addon-card__description">@(addon.Manifest.Description ?? "No description provided.")</p>
                    <dl class="addon-card__meta">
                        <div>
                            <dt>Version</dt>
                            <dd>@addon.Manifest.Version</dd>
                        </div>
                        <div>
                            <dt>Author</dt>
                            <dd>@addon.Manifest.Author</dd>
                        </div>
                        <div>
                            <dt>Type</dt>
                            <dd>@(addon.AssemblyPath is not null ? "C# plugin" : "TypeScript")</dd>
                        </div>
                    </dl>
                    <div class="addon-card__actions">
                        @if (settingsTab is not null)
                        {
                            <a class="icon-button addon-card__settings"
                               asp-controller="AdminAddon"
                               asp-action="Page"
                               asp-route-slug="@settingsTab.Slug"
                               title="@settingsTab.Label settings"
                               aria-label="@settingsTab.Label settings">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                                    <circle cx="12" cy="12" r="3.1" />
                                    <path d="M19.2 13.4a7.6 7.6 0 0 0 0-2.8l2-1.5-2-3.4-2.4 1a7.7 7.7 0 0 0-2.4-1.4L14 2.8h-4l-.4 2.5a7.7 7.7 0 0 0-2.4 1.4l-2.4-1-2 3.4 2 1.5a7.6 7.6 0 0 0 0 2.8l-2 1.5 2 3.4 2.4-1a7.7 7.7 0 0 0 2.4 1.4l.4 2.5h4l.4-2.5a7.7 7.7 0 0 0 2.4-1.4l2.4 1 2-3.4z" />
                                </svg>
                            </a>
                        }
                        <form method="post" asp-controller="Admin" asp-action="ToggleAddon" asp-route-id="@addon.Id" class="inline-form">
                            <input type="hidden" name="enabled" value="@((!addon.IsEnabled).ToString().ToLowerInvariant())" />
                            <button type="submit" class="button @(addon.IsEnabled ? "button--ghost" : "button--primary") button--sm">
                                @(addon.IsEnabled ? "Disable" : "Enable")
                            </button>
                        </form>
                    </div>
                </article>
            }
        </div>
    }
</section>
