@inject IThemeCatalog ThemeCatalog
@inject IAddonCatalog AddonCatalog
@{
    var themes = await ThemeCatalog.ListAsync();
    var activeTheme = await ThemeSelection.ResolveAsync(Context);
    var themeIds = string.Join(' ', themes.Select(theme => theme.Id));
    var panelName = Branding.Current.Name;
    var title = ViewData["Title"] as string ?? panelName;
    var logoUrl = activeTheme is not null && activeTheme.AssetUrls.TryGetValue("logo", out var themeLogo)
        ? themeLogo
        : null;
    var addonScripts = await AddonCatalog.ListAsync(enabledOnly: true);
}
<!DOCTYPE html>
<html lang="en" data-theme="@(activeTheme?.Id ?? "default_dark")" data-themes="@themeIds">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1f2937" />
    <title>@title · @panelName</title>
    <link rel="icon" href="@(logoUrl ?? Url.Content("~/logo.svg"))" />
    @* The browser owns the theme choice, so apply it before the stylesheets paint. *@
    <script>
        (() => {
            try {
                const stored = localStorage.getItem("rabbictyl.theme");
                const installed = (document.documentElement.dataset.themes || "").split(" ").filter(Boolean);
                if (stored && installed.includes(stored)) {
                    document.documentElement.dataset.theme = stored;
                }
            } catch {
                // Storage can be unavailable; the server-rendered theme stays.
            }
        })();
    </script>
    <link rel="stylesheet" href="~/assets/css/app.css" asp-append-version="true" />
    @foreach (var theme in themes)
    {
        foreach (var style in theme.StylesheetUrls)
        {
            <link rel="stylesheet" href="@style" />
        }
    }
</head>
<body class="ptero-auth-body" data-authenticated="false">
    <main class="ptero-auth">
        <div class="ptero-auth__brand">
            <partial name="_BrandMark" />
            <span>@panelName</span>
        </div>
        @RenderBody()
        <p class="ptero-auth__foot">@panelName panel</p>
    </main>
    <script src="~/assets/js/app.js" asp-append-version="true"></script>
    @foreach (var addon in addonScripts)
    {
        foreach (var script in addon.ScriptUrls)
        {
            <script type="module" src="@script"></script>
        }
    }
    @foreach (var theme in themes)
    {
        foreach (var script in theme.ScriptUrls)
        {
            <script type="module" src="@script"></script>
        }
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
