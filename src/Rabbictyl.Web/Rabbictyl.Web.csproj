<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Rabbictyl.Web</RootNamespace>
    <AssemblyName>Rabbictyl.Web</AssemblyName>
    <FrontendDirectory>$(MSBuildProjectDirectory)/../../frontend</FrontendDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rabbictyl.Core\Rabbictyl.Core.csproj" />
    <ProjectReference Include="..\Rabbictyl.Configuration\Rabbictyl.Configuration.csproj" />
    <ProjectReference Include="..\Rabbictyl.Addons.Abstractions\Rabbictyl.Addons.Abstractions.csproj" />
    <ProjectReference Include="..\Rabbictyl.Infrastructure\Rabbictyl.Infrastructure.csproj" />
    <!-- Build the bundled add-ons into their addon folders without linking them. -->
    <ProjectReference Include="..\Rabbictyl.Addon.DemoUser\Rabbictyl.Addon.DemoUser.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Rabbictyl.Addon.OAuth2\Rabbictyl.Addon.OAuth2.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Rabbictyl.Addon.EggBanners\Rabbictyl.Addon.EggBanners.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled themes and addons are read at runtime (manifests + assets) and
         copied next to the published app so a fresh deployment works. -->
    <Content Include="..\..\themes\**\*"
             Link="themes\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\addons\**\*"
             Link="addons\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\nests\**\*"
             Link="nests\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Localization\*.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.22">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <Target Name="BuildFrontend" BeforeTargets="Build" Condition="'$(BuildFrontend)' == 'true'">
    <Exec Command="bun install --frozen-lockfile" WorkingDirectory="$(FrontendDirectory)" />
    <Exec Command="bun run build" WorkingDirectory="$(FrontendDirectory)" />
  </Target>

</Project>
