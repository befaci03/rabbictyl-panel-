@model ThemesViewModel
@{
    ViewData["Title"] = "Themes";
    var isAdmin = User.IsInRole("admin");
    var selectedId = Context.Request.Cookies[ThemeSelection.CookieName];
}

<section class="page">
    <header class="page__header">
        <div>
            <span class="eyebrow">Appearance</span>
            <h1 class="page__title">Themes</h1>
            <p class="page__subtitle">Pick the look for this browser. Your choice is stored locally and does not change the panel for anyone else.</p>
        </div>
        <span class="pill pill--muted">@Model.Themes.Count</span>
    </header>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert--success" role="status">@success</div>
    }

    @if (Model.Themes.Count == 0)
    {
        <div class="card empty">
            <p class="empty__title">No themes installed</p>
            <p class="empty__hint">Add a folder with a manifest.json to the themes directory.</p>
        </div>
    }
    else
    {
        <div class="theme-grid">
            @foreach (var theme in Model.Themes)
            {
                var isSelected = string.Equals(theme.Id, selectedId, StringComparison.Ordinal);
                var isDefault = string.Equals(theme.Id, Model.ActiveThemeId, StringComparison.Ordinal);
                <article class="theme-card card @(isSelected ? "is-active" : string.Empty)"
                         data-theme-card="@theme.Id">
                    <div class="theme-card__top">
                        <span class="theme-card__swatch" aria-hidden="true"></span>
                        @if (isSelected)
                        {
                            <span class="badge badge--running">Selected</span>
                        }
                        else if (isDefault)
                        {
                            <span class="badge">Panel default</span>
                        }
                    </div>
                    <h2 class="theme-card__name">@theme.Name</h2>
                    <p class="theme-card__description">@(theme.Manifest.Description ?? "No description provided.")</p>
                    <dl class="theme-card__meta">
                        <div>
                            <dt>Version</dt>
                            <dd>@theme.Manifest.Version</dd>
                        </div>
                        <div>
                            <dt>Author</dt>
                            <dd>@theme.Manifest.Author</dd>
                        </div>
                    </dl>
                    <div class="theme-card__actions">
                        <button type="button"
                                class="button button--primary button--sm"
                                data-theme-select="@theme.Id"
                                @(isSelected ? "disabled" : null)>
                            @(isSelected ? "In use" : "Use this theme")
                        </button>
                        @if (isAdmin)
                        {
                            <form method="post" asp-controller="Themes" asp-action="Activate" asp-route-id="@theme.Id" class="inline-form">
                                <button type="submit" class="button button--ghost button--sm" title="Use this theme for visitors with no choice saved">
                                    Make default
                                </button>
                            </form>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>
