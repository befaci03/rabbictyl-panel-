@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}
<section class="page">
    <header class="page__header">
        <div>
            <h1 class="page__title">Dashboard</h1>
            <p class="page__subtitle">An overview of your panel.</p>
        </div>
    </header>

    <div class="stats">
        <article class="stat card">
            <span class="stat__label">Servers</span>
            <span class="stat__value">@Model.ServerCount</span>
            <span class="stat__hint">owned by you</span>
        </article>
        <article class="stat card">
            <span class="stat__label">Nodes</span>
            <span class="stat__value">@Model.NodeCount</span>
            <span class="stat__hint">registered</span>
        </article>
        <article class="stat card">
            <span class="stat__label">Users</span>
            <span class="stat__value">@Model.UserCount</span>
            <span class="stat__hint">accounts</span>
        </article>
    </div>

    <section class="card">
        <header class="card__header">
            <h2 class="card__title">Your servers</h2>
        </header>

        @if (Model.Servers.Count == 0)
        {
            <div class="empty">
                <p>You do not own any servers yet.</p>
                <p class="empty__hint">Once an administrator creates one, it will show up here.</p>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Node</th>
                            <th>Status</th>
                            <th>Memory</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var server in Model.Servers)
                    {
                        <tr>
                            <td>@server.Name</td>
                            <td>@(server.Node?.Name ?? "—")</td>
                            <td>
                                <span class="badge badge--@server.Status.ToString().ToLowerInvariant()">@server.Status</span>
                            </td>
                            <td>@server.MemoryLimitMb MB</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</section>
