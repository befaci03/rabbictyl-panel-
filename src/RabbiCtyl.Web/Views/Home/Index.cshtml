@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var isAdmin = User.IsInRole("admin");
}

<section class="page">
    <header class="page__header">
        <div>
            <h1 class="page__title">@L["home.title"]</h1>
            <p class="page__subtitle">@L["home.subtitle"]</p>
        </div>
        <div class="page__meta">
            @if (isAdmin)
            {
                <div class="segmented" role="group" aria-label="Server scope">
                    <a class="segmented__item @(Model.ShowAllServers ? string.Empty : "is-active")"
                       asp-controller="Home" asp-action="Index">@L["home.mine"]</a>
                    <a class="segmented__item @(Model.ShowAllServers ? "is-active" : string.Empty)"
                       asp-controller="Home" asp-action="Index" asp-route-scope="all">@L["home.all"]</a>
                </div>
            }
            <span class="pill pill--muted">@Model.Servers.Count</span>
        </div>
    </header>

    @if (Model.Servers.Count == 0)
    {
        <div class="card empty">
            <span class="empty__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                    <rect x="3" y="4" width="18" height="6" rx="2" />
                    <rect x="3" y="14" width="18" height="6" rx="2" />
                    <path d="M7 7h.01M7 17h.01" />
                </svg>
            </span>
            <p class="empty__title">@L["home.empty.title"]</p>
            <p class="empty__hint">@L["home.empty.hint"]</p>
        </div>
    }
    else
    {
        <div class="server-grid">
            @foreach (var server in Model.Servers)
            {
                <a class="server-card card" asp-controller="Server" asp-action="Index" asp-route-uuid="@server.Uuid">
                    <div class="server-card__top">
                        <span class="server-card__icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                                <rect x="3" y="4" width="18" height="6" rx="2" />
                                <rect x="3" y="14" width="18" height="6" rx="2" />
                                <path d="M7 7h.01M7 17h.01" />
                            </svg>
                        </span>
                        <span class="badge badge--@server.Status.ToString().ToLowerInvariant()">@server.Status</span>
                    </div>

                    <div>
                        <h2 class="server-card__name">@server.Name</h2>
                        <p class="server-card__description">
                            @(string.IsNullOrWhiteSpace(server.Description) ? "No description" : server.Description)
                        </p>
                    </div>

                    <dl class="server-card__meta">
                        @if (Model.ShowAllServers)
                        {
                            <div>
                                <dt>@L["home.owner"]</dt>
                                <dd>@(Model.OwnerNames.TryGetValue(server.OwnerId, out var ownerName) ? ownerName : L["home.unknownUser"])</dd>
                            </div>
                        }
                        <div>
                            <dt>@L["home.node"]</dt>
                            <dd>@(server.Node?.Name ?? "—")</dd>
                        </div>
                        <div>
                            <dt>@L["home.address"]</dt>
                            <dd>@(server.AllocationPort > 0 ? server.AllocationIp + ":" + server.AllocationPort : "—")</dd>
                        </div>
                        <div>
                            <dt>@L["home.memory"]</dt>
                            <dd>@server.MemoryLimitMb MB</dd>
                        </div>
                        <div>
                            <dt>@L["home.disk"]</dt>
                            <dd>@server.DiskLimitMb MB</dd>
                        </div>
                    </dl>
                    <span class="server-card__open">@L["server.manage"] &rarr;</span>
                </a>
            }
        </div>
    }
</section>
