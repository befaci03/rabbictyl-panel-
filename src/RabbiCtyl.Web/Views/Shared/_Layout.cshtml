@inject IThemeState ThemeState
@inject IThemeCatalog ThemeCatalog
@inject IAddonCatalog AddonCatalog
@inject IAntiforgery Antiforgery
@inject PanelOptions PanelOptions
@{
    var authenticated = User.Identity?.IsAuthenticated == true;
    var activeTheme = await ThemeCatalog.FindAsync(ThemeState.ActiveThemeId);
    var addons = authenticated
        ? await AddonCatalog.ListAsync(enabledOnly: true)
        : Array.Empty<AddonDescriptor>();
    var csrfToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var title = ViewData["Title"] as string ?? "Dashboard";
    var displayName = authenticated ? User.GetDisplayName() : string.Empty;
    var isAdmin = authenticated && User.IsInRole("admin");
    var logoUrl = activeTheme is not null && activeTheme.AssetUrls.TryGetValue("logo", out var themeLogo)
        ? themeLogo
        : null;
    var environmentLabel = string.Equals(
        PanelOptions.App.Environment,
        "Development",
        StringComparison.OrdinalIgnoreCase)
        ? L["env.development"]
        : PanelOptions.App.Environment;
    var panelName = Branding.Current.Name;
    var showSidebarLogo = !Branding.Current.HideSidebarLogo;
    var faviconUrl = Branding.LogoPath is not null
        ? $"{Url.Content("~/panel/logo")}?v={Branding.LogoVersion}"
        : logoUrl ?? Url.Content("~/logo.svg");
    ViewData["BrandLogoUrl"] = logoUrl;
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" data-theme="@(activeTheme?.Id ?? "default_dark")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content="@csrfToken" />
    <meta name="theme-color" content="#0a0c10" />
    <title>@title · @panelName</title>
    <link rel="icon" href="@faviconUrl" />
    <link rel="stylesheet" href="~/assets/css/app.css" asp-append-version="true" />
    @if (activeTheme is not null)
    {
        foreach (var style in activeTheme.StylesheetUrls)
        {
            <link rel="stylesheet" href="@style" />
        }
    }
</head>
<body data-authenticated="@(authenticated ? "true" : "false")">
@if (authenticated)
{
    <div class="app-shell" id="app-shell">
        <aside class="sidebar" id="sidebar">
            <div class="sidebar__head">
                <button type="button"
                        class="icon-button sidebar__collapse"
                        id="sidebar-collapse"
                        aria-controls="sidebar"
                        aria-expanded="true"
                        title="@L["nav.collapse"]"
                        aria-label="@L["nav.collapse"]">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                        <path d="M13 6l-6 6 6 6M19 6l-6 6 6 6" />
                    </svg>
                </button>

                <a class="brand" asp-controller="Home" asp-action="Index">
                    @if (showSidebarLogo)
                    {
                        <partial name="_BrandMark" />
                    }
                    <span class="brand__text">
                        <span class="brand__name">@panelName</span>
                    </span>
                </a>
            </div>

            <button type="button"
                    class="sidebar-expand"
                    id="sidebar-expand"
                    aria-controls="sidebar"
                    aria-expanded="false"
                    title="@L["nav.expand"]"
                    aria-label="@L["nav.expand"]">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                    <path d="M11 6l6 6-6 6M5 6l6 6-6 6" />
                </svg>
            </button>

            <div class="sidebar__scroll">
                <partial name="_SidebarNav" />
            </div>

            <div class="sidebar__footer">
                <div class="user-chip">
                    <a class="user-chip__meta" asp-controller="Account" asp-action="Index" title="@L["nav.account"]">
                        <span class="user-chip__name">@displayName</span>
                        <span class="user-chip__role">@(isAdmin ? L["role.admin"] : L["role.member"])</span>
                    </a>
                    <form method="post" asp-controller="Auth" asp-action="Logout" class="user-chip__form">
                        <button type="submit" class="icon-button" title="@L["nav.signout"]" aria-label="@L["nav.signout"]">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                                <path d="M14 4.5h3A2.5 2.5 0 0 1 19.5 7v10a2.5 2.5 0 0 1-2.5 2.5h-3" />
                                <path d="M10 8l4 4-4 4M14 12H4.5" />
                            </svg>
                        </button>
                    </form>
                </div>
            </div>
        </aside>

        <div class="sidebar-backdrop" data-sidebar-close aria-hidden="true"></div>

        <div class="app-main">
            <header class="topbar">
                <div class="topbar__left">
                    <button type="button"
                            class="icon-button sidebar-toggle"
                            id="sidebar-toggle"
                            aria-controls="sidebar"
                            aria-label="@L["nav.open"]"
                            aria-expanded="false"
                            title="@L["nav.open"]"
                            data-label-collapse="@L["nav.collapse"]"
                            data-label-expand="@L["nav.expand"]"
                            data-label-open="@L["nav.open"]"
                            data-label-close="@L["nav.close"]">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                            <rect x="3.5" y="4" width="17" height="16" rx="2" />
                            <path d="M9.5 4v16M6 8h.01M6 12h.01M6 16h.01" />
                        </svg>
                    </button>
                    <div class="topbar__crumb">
                        <span>@panelName</span>
                        <span class="topbar__slash">/</span>
                        <strong>@title</strong>
                    </div>
                </div>
                <div class="topbar__meta">
                    <partial name="_LocaleSwitcher" />
                    <span class="pill pill--muted">@environmentLabel</span>
                </div>
            </header>
            <main class="content">
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    <main class="content content--bare">
        @RenderBody()
    </main>
}
<script src="~/assets/js/app.js" asp-append-version="true"></script>
@if (authenticated)
{
    foreach (var addon in addons)
    {
        foreach (var script in addon.ScriptUrls)
        {
            <script type="module" src="@script"></script>
        }
    }
}
@if (activeTheme is not null)
{
    foreach (var script in activeTheme.ScriptUrls)
    {
        <script type="module" src="@script"></script>
    }
}
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
