@inject IThemeCatalog ThemeCatalog
@inject IAddonCatalog AddonCatalog
@inject IAntiforgery Antiforgery
@inject PanelOptions PanelOptions
@{
    var authenticated = User.Identity?.IsAuthenticated == true;
    var themes = await ThemeCatalog.ListAsync();
    var activeTheme = await ThemeSelection.ResolveAsync(Context);
    var themeIds = string.Join(' ', themes.Select(theme => theme.Id));
    var addons = authenticated
        ? await AddonCatalog.ListAsync(enabledOnly: true)
        : Array.Empty<AddonDescriptor>();
    var csrfToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var title = ViewData["Title"] as string ?? "Dashboard";
    var displayName = authenticated ? User.GetDisplayName() : string.Empty;
    var isAdmin = authenticated && User.IsInRole("admin");
    var currentServer = ViewData["Server"] as Server;
    var currentSection = ViewData["ServerSection"] as string ?? "console";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var logoUrl = activeTheme is not null && activeTheme.AssetUrls.TryGetValue("logo", out var themeLogo)
        ? themeLogo
        : null;
    var environmentLabel = string.Equals(
        PanelOptions.App.Environment,
        "Development",
        StringComparison.OrdinalIgnoreCase)
        ? L["env.development"]
        : PanelOptions.App.Environment;
    var panelName = Branding.Current.Name;
    var showLogo = !Branding.Current.HideSidebarLogo;
    var faviconUrl = Branding.LogoPath is not null
        ? $"{Url.Content("~/panel/logo")}?v={Branding.LogoVersion}"
        : logoUrl ?? Url.Content("~/logo.svg");
    var restrictedServer = currentServer is not null && currentServer.AccessRestricted && !isAdmin;
    ViewData["BrandLogoUrl"] = logoUrl;

    string NavClass(string controllerName, string? actionName = null)
    {
        var matchesController = string.Equals(currentController, controllerName, StringComparison.OrdinalIgnoreCase);
        var matchesAction = actionName is null
            || string.Equals(currentAction, actionName, StringComparison.OrdinalIgnoreCase);

        return matchesController && matchesAction
            ? "ptero-nav__link is-active"
            : "ptero-nav__link";
    }

    string TabClass(string section) =>
        string.Equals(currentSection, section, StringComparison.OrdinalIgnoreCase)
            ? "ptero-servertab is-active"
            : "ptero-servertab";

    string StatusClass(ServerStatus status) => status switch
    {
        ServerStatus.Running => "is-running",
        ServerStatus.Starting or ServerStatus.Installing or ServerStatus.RestoringBackup => "is-busy",
        ServerStatus.Stopping or ServerStatus.Suspended or ServerStatus.InstallFailed => "is-stopped",
        _ => "is-offline",
    };
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName"
      data-theme="@(activeTheme?.Id ?? "default_dark")"
      data-themes="@themeIds">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content="@csrfToken" />
    <meta name="theme-color" content="#111827" />
    <title>@title · @panelName</title>
    <link rel="icon" href="@faviconUrl" />
    @* The browser owns the theme choice, so apply it before the stylesheets paint. *@
    <script>
        (() => {
            try {
                const stored = localStorage.getItem("rabbictyl.theme");
                const installed = (document.documentElement.dataset.themes || "").split(" ").filter(Boolean);
                if (stored && installed.includes(stored)) {
                    document.documentElement.dataset.theme = stored;
                }
            } catch {
                // Storage can be unavailable; the server-rendered theme stays.
            }
        })();
    </script>
    <link rel="stylesheet" href="~/assets/css/app.css" asp-append-version="true" />
    @foreach (var theme in themes)
    {
        foreach (var style in theme.StylesheetUrls)
        {
            <link rel="stylesheet" href="@style" />
        }
    }
</head>
<body class="ptero-body" data-authenticated="@(authenticated ? "true" : "false")">
@if (authenticated)
{
    <div class="ptero-shell" id="app-shell">
        @* Pterodactyl has no sidebar: a single navbar, the content, then a footer. *@
        <header class="ptero-topbar">
            <button type="button"
                    class="ptero-menu"
                    id="sidebar-toggle"
                    aria-controls="sidebar"
                    aria-label="@L["nav.open"]"
                    aria-expanded="false"
                    title="@L["nav.open"]"
                    data-label-open="@L["nav.open"]"
                    data-label-close="@L["nav.close"]">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="M4 7h16M4 12h16M4 17h16" />
                </svg>
            </button>

            <a class="ptero-topbar__brand" asp-controller="Home" asp-action="Index">
                @if (showLogo)
                {
                    <partial name="_BrandMark" />
                }
                <span class="ptero-topbar__brand-name">@panelName</span>
            </a>

            <nav class="ptero-nav" id="sidebar" aria-label="Primary">
                <a class="@NavClass("Home", "Index")" asp-controller="Home" asp-action="Index">@L["nav.dashboard"]</a>
                <a class="@NavClass("Home", "Overview")" asp-controller="Home" asp-action="Overview">@L["nav.overview"]</a>
                <a class="@NavClass("Account")" asp-controller="Account" asp-action="Index">@L["nav.account"]</a>
                <a class="@NavClass("Themes")" asp-controller="Themes" asp-action="Index">@L["nav.themes"]</a>
                @if (isAdmin)
                {
                    <a class="@NavClass("Admin")" asp-controller="Admin" asp-action="Nodes">@L["nav.administration"]</a>
                }
            </nav>

            <div class="ptero-topbar__meta">
                <span class="ptero-topbar__user">@displayName</span>
                <partial name="_LocaleSwitcher" />
                <span class="pill pill--muted">@environmentLabel</span>
                <form method="post" asp-controller="Auth" asp-action="Logout" class="user-chip__form">
                    <button type="submit" class="icon-button" title="@L["nav.signout"]" aria-label="@L["nav.signout"]">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                            <path d="M14 4.5h3A2.5 2.5 0 0 1 19.5 7v10a2.5 2.5 0 0 1-2.5 2.5h-3" />
                            <path d="M10 8l4 4-4 4M14 12H4.5" />
                        </svg>
                    </button>
                </form>
            </div>
        </header>

        <div class="ptero-backdrop" data-sidebar-close aria-hidden="true"></div>

        <main class="ptero-main">
            @if (currentServer is not null)
            {
                <div class="ptero-serverhead">
                    <div class="ptero-serverhead__main">
                        <span class="ptero-serverhead__dot @StatusClass(currentServer.Status)"></span>
                        <div class="ptero-serverhead__text">
                            <strong>@currentServer.Name</strong>
                            <span>@currentServer.AllocationIp:@currentServer.AllocationPort · @currentServer.Status</span>
                        </div>
                    </div>

                    <a class="button button--ghost button--sm"
                       asp-controller="Home"
                       asp-action="Index">
                        @L["nav.dashboard"]
                    </a>
                </div>

                <nav class="ptero-servertabs" aria-label="@currentServer.Name">
                    <a class="@TabClass("console")"
                       asp-controller="Server" asp-action="Index" asp-route-uuid="@currentServer.Uuid" asp-route-section="console">@L["nav.console"]</a>
                    <a class="@TabClass("files")"
                       asp-controller="Server" asp-action="Index" asp-route-uuid="@currentServer.Uuid" asp-route-section="files">@L["nav.files"]</a>
                    @if (!restrictedServer)
                    {
                        <a class="@TabClass("backups")"
                           asp-controller="Server" asp-action="Index" asp-route-uuid="@currentServer.Uuid" asp-route-section="backups">@L["nav.backups"]</a>
                        <a class="@TabClass("schedules")"
                           asp-controller="Server" asp-action="Index" asp-route-uuid="@currentServer.Uuid" asp-route-section="schedules">@L["nav.schedules"]</a>
                        <a class="@TabClass("users")"
                           asp-controller="Server" asp-action="Index" asp-route-uuid="@currentServer.Uuid" asp-route-section="users">@L["nav.users"]</a>
                        <a class="@TabClass("startup")"
                           asp-controller="Server" asp-action="Index" asp-route-uuid="@currentServer.Uuid" asp-route-section="startup">@L["nav.startup"]</a>
                    }
                    <a class="@TabClass("settings")"
                       asp-controller="Server" asp-action="Index" asp-route-uuid="@currentServer.Uuid" asp-route-section="settings">@L["nav.settings"]</a>
                </nav>
            }

            <div class="ptero-content">
                @RenderBody()
            </div>
        </main>

        <footer class="ptero-footer">
            <span>@panelName @DateTime.UtcNow.Year - @DateTime.UtcNow.Year</span>
        </footer>
    </div>
}
else
{
    <main class="content content--bare">
        @RenderBody()
    </main>
}
<script src="~/assets/js/app.js" asp-append-version="true"></script>
@if (authenticated)
{
    foreach (var addon in addons)
    {
        foreach (var script in addon.ScriptUrls)
        {
            <script type="module" src="@script"></script>
        }
    }
}
@foreach (var theme in themes)
{
    foreach (var script in theme.ScriptUrls)
    {
        <script type="module" src="@script"></script>
    }
}
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
