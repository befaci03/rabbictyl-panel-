@inject IServerStore ServerStore
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentSection = ViewData["ServerSection"] as string ?? "console";
    var currentServer = ViewData["Server"] as Server;

    if (currentServer is null &&
        string.Equals(currentController, "Server", StringComparison.OrdinalIgnoreCase) &&
        Guid.TryParse(ViewContext.RouteData.Values["uuid"]?.ToString(), out var uuid))
    {
        currentServer = await ServerStore.FindByUuidAsync(uuid);
    }

    var isAdmin = User.Identity?.IsAuthenticated == true && User.IsInRole("admin");

    string NavClass(string controllerName, string? actionName = null)
    {
        var controllerMatches = string.Equals(currentController, controllerName, StringComparison.OrdinalIgnoreCase);
        var actionMatches = actionName is null
            || string.Equals(currentAction, actionName, StringComparison.OrdinalIgnoreCase);

        return controllerMatches && actionMatches
            ? "nav__link nav__link--active"
            : "nav__link";
    }

    string ServerNavClass(string section) =>
        string.Equals(currentSection, section, StringComparison.OrdinalIgnoreCase)
            ? "nav__link nav__link--active"
            : "nav__link";
}

<nav class="nav" aria-label="Primary">
    <span class="nav__label">@L["nav.workspace"]</span>
    <a class="@NavClass("Home", "Index")" asp-controller="Home" asp-action="Index" title="@L["nav.dashboard"]">
        <svg class="nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <rect x="3.5" y="3.5" width="7" height="7" rx="1.6" />
            <rect x="13.5" y="3.5" width="7" height="7" rx="1.6" />
            <rect x="3.5" y="13.5" width="7" height="7" rx="1.6" />
            <rect x="13.5" y="13.5" width="7" height="7" rx="1.6" />
        </svg>
        <span>@L["nav.dashboard"]</span>
    </a>

    <a class="@NavClass("Home", "Overview")" asp-controller="Home" asp-action="Overview" title="@L["nav.overview"]">
        <svg class="nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <path d="M4 19.5V10M10 19.5V5M16 19.5v-6M22 19.5H2" />
        </svg>
        <span>@L["nav.overview"]</span>
    </a>

    <a class="@NavClass("Account")" asp-controller="Account" asp-action="Index" title="@L["nav.account"]">
        <svg class="nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <circle cx="12" cy="8" r="3.4" />
            <path d="M5 20c.7-3.4 3.5-5.2 7-5.2s6.3 1.8 7 5.2" />
        </svg>
        <span>@L["nav.account"]</span>
    </a>

    @if (currentServer is not null)
    {
        <span class="nav__label nav__label--server">
            <span>@L["nav.server"]</span>
            <span class="nav__server-name" title="@currentServer.Name">@currentServer.Name</span>
        </span>

        <a class="@ServerNavClass("console")"
           asp-controller="Server" asp-action="Index" asp-route-uuid="@currentServer.Uuid" asp-route-section="console"
           title="@L["nav.console"]">
            <svg class="nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                <rect x="3" y="4.5" width="18" height="15" rx="2" />
                <path d="m7 9 3 3-3 3M12.5 15H17" />
            </svg>
            <span>@L["nav.console"]</span>
        </a>

        <a class="@ServerNavClass("files")"
           asp-controller="Server" asp-action="Index" asp-route-uuid="@currentServer.Uuid" asp-route-section="files"
           title="@L["nav.files"]">
            <svg class="nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                <path d="M3.5 7.5A2 2 0 0 1 5.5 5.5h3l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2v-10Z" />
            </svg>
            <span>@L["nav.files"]</span>
        </a>

        <a class="@ServerNavClass("backups")"
           asp-controller="Server" asp-action="Index" asp-route-uuid="@currentServer.Uuid" asp-route-section="backups"
           title="@L["nav.backups"]">
            <svg class="nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                <path d="M4 7.5h16v11H4zM4 7.5 6 4h12l2 3.5" />
                <path d="M9 12h6" />
            </svg>
            <span>@L["nav.backups"]</span>
        </a>

        <a class="@ServerNavClass("schedules")"
           asp-controller="Server" asp-action="Index" asp-route-uuid="@currentServer.Uuid" asp-route-section="schedules"
           title="@L["nav.schedules"]">
            <svg class="nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                <circle cx="12" cy="12" r="8.5" />
                <path d="M12 7.5V12l3 2" />
            </svg>
            <span>@L["nav.schedules"]</span>
        </a>

        <a class="@ServerNavClass("users")"
           asp-controller="Server" asp-action="Index" asp-route-uuid="@currentServer.Uuid" asp-route-section="users"
           title="@L["nav.users"]">
            <svg class="nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                <circle cx="9" cy="8" r="3" />
                <path d="M3.5 19c.6-3.2 2.7-5 5.5-5s4.9 1.8 5.5 5M16 8.5a2.5 2.5 0 1 1 0 5M17 14.5c2 0 3.2 1.4 3.5 4" />
            </svg>
            <span>@L["nav.users"]</span>
        </a>

        <a class="@ServerNavClass("startup")"
           asp-controller="Server" asp-action="Index" asp-route-uuid="@currentServer.Uuid" asp-route-section="startup"
           title="@L["nav.startup"]">
            <svg class="nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                <path d="M13.5 3.5c3 0 5.5 2.5 5.5 5.5-1 5.5-6 10.5-6 10.5l-4-4s1.5-6 4.5-9Z" />
                <circle cx="15.5" cy="8.5" r="1.5" />
                <path d="m7.5 16.5-3 3M5 14l-2 2M10 19l-2 2" />
            </svg>
            <span>@L["nav.startup"]</span>
        </a>

        <a class="@ServerNavClass("settings")"
           asp-controller="Server" asp-action="Index" asp-route-uuid="@currentServer.Uuid" asp-route-section="settings"
           title="@L["nav.settings"]">
            <svg class="nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                <circle cx="12" cy="12" r="3" />
                <path d="M12 3.5v2M12 18.5v2M20.5 12h-2M5.5 12h-2M18 6l-1.4 1.4M7.4 16.6 6 18M18 18l-1.4-1.4M7.4 7.4 6 6" />
            </svg>
            <span>@L["nav.settings"]</span>
        </a>
    }

    <span class="nav__label">@L["nav.system"]</span>
    <a class="@NavClass("Themes")" asp-controller="Themes" asp-action="Index" title="@L["nav.themes"]">
        <svg class="nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <path d="M12 3.5a8.5 8.5 0 1 0 0 17c1.4 0 2.2-.8 2.2-1.8 0-.8-.5-1.3-.5-2 0-1 .8-1.7 1.9-1.7h1.6c1.8 0 3.3-1.5 3.3-3.3C20.5 6.5 16.7 3.5 12 3.5Z" />
            <circle cx="7.8" cy="11" r="1" fill="currentColor" stroke="none" />
            <circle cx="10.2" cy="7.4" r="1" fill="currentColor" stroke="none" />
            <circle cx="14.6" cy="7.4" r="1" fill="currentColor" stroke="none" />
        </svg>
        <span>@L["nav.themes"]</span>
    </a>

    @if (isAdmin)
    {
        <a class="@NavClass("Admin")" asp-controller="Admin" asp-action="Nodes" title="@L["nav.administration"]">
            <svg class="nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                <path d="M12 3.5 20 8v8l-8 4.5L4 16V8l8-4.5Z" />
                <path d="m4 8 8 4.5L20 8M12 12.5V20.5" />
            </svg>
            <span>@L["nav.administration"]</span>
        </a>
    }
</nav>
