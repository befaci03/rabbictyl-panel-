@model OAuthAdminViewModel
@inject PanelOptions PanelOptions
@{
    ViewData["Title"] = L["admin.oauth2"].ToString();
    var panelUrl = PanelOptions.App.Url.TrimEnd('/');
}

<section class="page">
    <header class="page__header">
        <div>
            <span class="eyebrow">@L["admin.eyebrow"]</span>
            <h1 class="page__title">@L["admin.oauth2"]</h1>
            <p class="page__subtitle">@L["admin.oauth2.subtitle"]</p>
        </div>
    </header>

    <partial name="_AdminTabs" />

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert--success" role="status">@success</div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert--danger" role="alert">@error</div>
    }

    @if (!Model.AddonEnabled)
    {
        <div class="alert alert--warning" role="status">@L["admin.oauth2.addonDisabled"]</div>
    }

    <details class="card admin-create" @(Model.Providers.Count == 0 ? "open" : null)>
        <summary class="admin-create__summary">
            <span>
                <strong>@L["admin.oauth2.create"]</strong>
                <span class="admin-create__hint">@L["admin.oauth2.createHint"]</span>
            </span>
            <span class="button button--primary button--sm">@L["admin.oauth2.create"]</span>
        </summary>
        <div class="admin-create__body">
            <form method="post" asp-controller="Admin" asp-action="CreateOAuthProvider" class="form">
                <div class="admin-create__grid">
                    <div class="form__group">
                        <label class="form__label" for="oauth-id">@L["admin.oauth2.id"]</label>
                        <input class="form__input" id="oauth-id" name="Id" required maxlength="48" placeholder="github" />
                        <span class="form__hint">@L["admin.oauth2.idHint"]</span>
                    </div>
                    <div class="form__group">
                        <label class="form__label" for="oauth-name">@L["admin.oauth2.name"]</label>
                        <input class="form__input" id="oauth-name" name="Name" required maxlength="96" placeholder="GitHub" />
                    </div>
                    <div class="form__group">
                        <label class="form__label" for="oauth-client">@L["admin.oauth2.clientId"]</label>
                        <input class="form__input" id="oauth-client" name="ClientId" required maxlength="255" />
                    </div>
                    <div class="form__group">
                        <label class="form__label" for="oauth-secret">@L["admin.oauth2.clientSecret"]</label>
                        <input class="form__input" id="oauth-secret" name="ClientSecret" type="password" required maxlength="512" />
                    </div>
                    <div class="form__group">
                        <label class="form__label" for="oauth-authorize">@L["admin.oauth2.authorizeUrl"]</label>
                        <input class="form__input" id="oauth-authorize" name="AuthorizeUrl" type="url" required maxlength="1024" placeholder="https://github.com/login/oauth/authorize" />
                    </div>
                    <div class="form__group">
                        <label class="form__label" for="oauth-token">@L["admin.oauth2.tokenUrl"]</label>
                        <input class="form__input" id="oauth-token" name="TokenUrl" type="url" required maxlength="1024" placeholder="https://github.com/login/oauth/access_token" />
                    </div>
                    <div class="form__group">
                        <label class="form__label" for="oauth-userinfo">@L["admin.oauth2.userInfoUrl"]</label>
                        <input class="form__input" id="oauth-userinfo" name="UserInfoUrl" type="url" required maxlength="1024" placeholder="https://api.github.com/user" />
                    </div>
                    <div class="form__group">
                        <label class="form__label" for="oauth-scopes">@L["admin.oauth2.scopes"]</label>
                        <input class="form__input" id="oauth-scopes" name="Scopes" maxlength="256" value="openid email profile" />
                    </div>
                    <div class="form__group">
                        <label class="form__label" for="oauth-user-id">@L["admin.oauth2.userIdField"]</label>
                        <input class="form__input" id="oauth-user-id" name="UserIdField" maxlength="64" value="id" />
                    </div>
                    <div class="form__group">
                        <label class="form__label" for="oauth-email">@L["admin.oauth2.emailField"]</label>
                        <input class="form__input" id="oauth-email" name="EmailField" maxlength="64" value="email" />
                    </div>
                    <div class="form__group">
                        <label class="form__label" for="oauth-username">@L["admin.oauth2.usernameField"]</label>
                        <input class="form__input" id="oauth-username" name="UsernameField" maxlength="64" value="username" />
                    </div>
                    <div class="form__group">
                        <label class="form__label" for="oauth-display">@L["admin.oauth2.displayNameField"]</label>
                        <input class="form__input" id="oauth-display" name="DisplayNameField" maxlength="64" value="name" />
                    </div>
                </div>

                <div class="admin-create__checks">
                    <label class="form__check">
                        <input type="checkbox" name="Enabled" value="true" checked />
                        @L["admin.oauth2.enabled"]
                    </label>
                </div>

                <div class="admin-create__actions">
                    <button type="submit" class="button button--primary">@L["admin.oauth2.create"]</button>
                </div>
            </form>
        </div>
    </details>

    <section class="card card--flush">
        @if (Model.Providers.Count == 0)
        {
            <div class="empty">
                <p class="empty__title">@L["admin.oauth2.empty"]</p>
                <p class="empty__hint">@L["admin.oauth2.emptyHint"]</p>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>@L["admin.oauth2.name"]</th>
                            <th>@L["admin.oauth2.callback"]</th>
                            <th>@L["admin.oauth2.status"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var provider in Model.Providers)
                    {
                        <tr>
                            <td>
                                <span class="table__primary">@provider.Name</span>
                                <span class="table__secondary">@provider.Id</span>
                            </td>
                            <td>
                                <code class="table__secondary">@panelUrl/auth/oauth/@provider.Id/callback</code>
                            </td>
                            <td>
                                @if (provider.Enabled && provider.IsConfigured)
                                {
                                    <span class="badge badge--running">@L["admin.oauth2.active"]</span>
                                }
                                else if (provider.Enabled)
                                {
                                    <span class="badge badge--suspended">@L["admin.oauth2.incomplete"]</span>
                                }
                                else
                                {
                                    <span class="badge">@L["admin.oauth2.disabled"]</span>
                                }
                            </td>
                            <td>
                                <div class="table__actions">
                                    <details class="node-config">
                                        <summary class="button button--ghost button--sm">@L["admin.oauth2.edit"]</summary>
                                        <div class="node-config__body">
                                            <form method="post" asp-controller="Admin" asp-action="UpdateOAuthProvider" asp-route-id="@provider.Id" class="form">
                                                <div class="admin-create__grid">
                                                    <div class="form__group">
                                                        <label class="form__label" for="edit-name-@provider.Id">@L["admin.oauth2.name"]</label>
                                                        <input class="form__input" id="edit-name-@provider.Id" name="Name" value="@provider.Name" required maxlength="96" />
                                                    </div>
                                                    <div class="form__group">
                                                        <label class="form__label" for="edit-client-@provider.Id">@L["admin.oauth2.clientId"]</label>
                                                        <input class="form__input" id="edit-client-@provider.Id" name="ClientId" value="@provider.ClientId" required maxlength="255" />
                                                    </div>
                                                    <div class="form__group">
                                                        <label class="form__label" for="edit-secret-@provider.Id">@L["admin.oauth2.clientSecret"]</label>
                                                        <input class="form__input" id="edit-secret-@provider.Id" name="ClientSecret" type="password" maxlength="512" placeholder="@L["admin.oauth2.secretKeep"]" />
                                                    </div>
                                                    <div class="form__group">
                                                        <label class="form__label" for="edit-scopes-@provider.Id">@L["admin.oauth2.scopes"]</label>
                                                        <input class="form__input" id="edit-scopes-@provider.Id" name="Scopes" value="@provider.Scopes" maxlength="256" />
                                                    </div>
                                                    <div class="form__group">
                                                        <label class="form__label" for="edit-authorize-@provider.Id">@L["admin.oauth2.authorizeUrl"]</label>
                                                        <input class="form__input" id="edit-authorize-@provider.Id" name="AuthorizeUrl" type="url" value="@provider.AuthorizeUrl" required maxlength="1024" />
                                                    </div>
                                                    <div class="form__group">
                                                        <label class="form__label" for="edit-token-@provider.Id">@L["admin.oauth2.tokenUrl"]</label>
                                                        <input class="form__input" id="edit-token-@provider.Id" name="TokenUrl" type="url" value="@provider.TokenUrl" required maxlength="1024" />
                                                    </div>
                                                    <div class="form__group">
                                                        <label class="form__label" for="edit-userinfo-@provider.Id">@L["admin.oauth2.userInfoUrl"]</label>
                                                        <input class="form__input" id="edit-userinfo-@provider.Id" name="UserInfoUrl" type="url" value="@provider.UserInfoUrl" required maxlength="1024" />
                                                    </div>
                                                    <div class="form__group">
                                                        <label class="form__label" for="edit-email-@provider.Id">@L["admin.oauth2.emailField"]</label>
                                                        <input class="form__input" id="edit-email-@provider.Id" name="EmailField" value="@provider.EmailField" maxlength="64" />
                                                    </div>
                                                    <div class="form__group">
                                                        <label class="form__label" for="edit-username-@provider.Id">@L["admin.oauth2.usernameField"]</label>
                                                        <input class="form__input" id="edit-username-@provider.Id" name="UsernameField" value="@provider.UsernameField" maxlength="64" />
                                                    </div>
                                                    <div class="form__group">
                                                        <label class="form__label" for="edit-display-@provider.Id">@L["admin.oauth2.displayNameField"]</label>
                                                        <input class="form__input" id="edit-display-@provider.Id" name="DisplayNameField" value="@provider.DisplayNameField" maxlength="64" />
                                                    </div>
                                                    <div class="form__group">
                                                        <label class="form__label" for="edit-userid-@provider.Id">@L["admin.oauth2.userIdField"]</label>
                                                        <input class="form__input" id="edit-userid-@provider.Id" name="UserIdField" value="@provider.UserIdField" maxlength="64" />
                                                    </div>
                                                </div>

                                                <label class="form__check">
                                                    <input type="checkbox" name="Enabled" value="true" checked="@provider.Enabled" />
                                                    @L["admin.oauth2.enabled"]
                                                </label>

                                                <div class="admin-create__actions">
                                                    <button type="submit" class="button button--primary button--sm">@L["admin.oauth2.save"]</button>
                                                </div>
                                            </form>
                                        </div>
                                    </details>

                                    <form method="post" asp-controller="Admin" asp-action="DeleteOAuthProvider" asp-route-id="@provider.Id" class="inline-form">
                                        <button type="submit" class="button button--ghost button--sm">@L["admin.oauth2.delete"]</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</section>
