@model IReadOnlyList<GameTemplate>
@{
    ViewData["Title"] = L["admin.games"].ToString();
}

<section class="page">
    <header class="page__header">
        <div>
            <span class="eyebrow">@L["admin.eyebrow"]</span>
            <h1 class="page__title">@L["admin.games"]</h1>
            <p class="page__subtitle">@L["admin.games.subtitle"]</p>
        </div>
        <span class="pill pill--muted">@Model.Count</span>
    </header>

    <partial name="_AdminTabs" />

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert--success" role="status">@success</div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert--danger" role="alert">@error</div>
    }

    <p class="form__hint">@L["admin.games.nestHint"]</p>

    <details class="card admin-create" @(Model.Count == 0 ? "open" : null)>
        <summary class="admin-create__summary">
            <span>
                <strong>@L["admin.games.create"]</strong>
                <span class="admin-create__hint">@L["admin.games.createHint"]</span>
            </span>
            <span class="button button--primary button--sm">@L["admin.games.create"]</span>
        </summary>
        <div class="admin-create__body">
            <form method="post" asp-controller="Admin" asp-action="CreateGame" class="form">
                <div class="admin-create__grid">
                    <div class="form__group">
                        <label class="form__label" for="game-name">@L["admin.games.name"]</label>
                        <input class="form__input" id="game-name" name="Name" required maxlength="191" placeholder="Minecraft Java" />
                    </div>
                    <div class="form__group">
                        <label class="form__label" for="game-author">@L["admin.games.author"]</label>
                        <input class="form__input" id="game-author" name="Author" maxlength="191" placeholder="RabbiCtyl" />
                    </div>
                    <div class="form__group">
                        <label class="form__label" for="game-image">@L["server.startup.image"]</label>
                        <input class="form__input" id="game-image" name="Image" required maxlength="255" value="ghcr.io/pterodactyl/yolks:java_21" />
                    </div>
                    <div class="form__group">
                        <label class="form__label" for="game-description">@L["admin.games.description"]</label>
                        <input class="form__input" id="game-description" name="Description" maxlength="1024" />
                    </div>
                </div>

                <div class="form__group">
                    <label class="form__label" for="game-startup">@L["server.startup.command"]</label>
                    <input class="form__input" id="game-startup" name="Startup" required maxlength="1024" value="java -Xms128M -Xmx{{SERVER_MEMORY}}M -jar {{SERVER_JARFILE}}" />
                </div>

                <div class="admin-create__grid">
                    <div class="form__group">
                        <label class="form__label" for="game-done">@L["admin.games.done"]</label>
                        <textarea class="form__input" id="game-done" name="DonePatterns" rows="3" placeholder="regex:.*Done.*"></textarea>
                        <span class="form__hint">@L["admin.games.doneHint"]</span>
                    </div>
                    <div class="form__group">
                        <label class="form__label" for="game-stop">@L["admin.games.stop"]</label>
                        <input class="form__input" id="game-stop" name="StopValue" maxlength="64" value="stop" />
                    </div>
                    <div class="form__group">
                        <label class="form__label" for="game-script-container">@L["admin.games.scriptContainer"]</label>
                        <input class="form__input" id="game-script-container" name="ScriptContainer" maxlength="255" value="ghcr.io/pterodactyl/installers:alpine" />
                    </div>
                    <div class="form__group">
                        <label class="form__label" for="game-script-entrypoint">@L["admin.games.scriptEntrypoint"]</label>
                        <input class="form__input" id="game-script-entrypoint" name="ScriptEntrypoint" maxlength="255" value="ash" />
                    </div>
                </div>

                <div class="form__group">
                    <label class="form__label" for="game-variables">@L["admin.games.variables"]</label>
                    <textarea class="form__input" id="game-variables" name="Variables" rows="4" placeholder="SERVER_JARFILE=server.jar&#10;JAVA_VERSION=21"></textarea>
                    <span class="form__hint">@L["admin.games.variablesHint"]</span>
                </div>

                <div class="form__group">
                    <label class="form__label" for="game-install">@L["admin.games.installScript"]</label>
                    <textarea class="form__input" id="game-install" name="InstallScript" rows="6" spellcheck="false" placeholder="#!/bin/ash&#10;apk add --no-cache curl&#10;curl -o server.jar https://example.com/server.jar"></textarea>
                </div>

                <div class="admin-create__actions">
                    <button type="submit" class="button button--primary">@L["admin.games.create"]</button>
                </div>
            </form>
        </div>
    </details>

    <section class="card card--flush">
        @if (Model.Count == 0)
        {
            <div class="empty">
                <p class="empty__title">@L["admin.games.empty"]</p>
                <p class="empty__hint">@L["admin.games.emptyHint"]</p>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>@L["admin.games.name"]</th>
                            <th>@L["admin.games.source"]</th>
                            <th>@L["server.startup.image"]</th>
                            <th class="table__number">@L["admin.games.variablesCount"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var template in Model)
                    {
                        <tr>
                            <td>
                                <span class="table__primary">@template.Egg.Name</span>
                                <span class="table__secondary">@(string.IsNullOrWhiteSpace(template.Egg.Description) ? template.Egg.Uuid.ToString() : template.Egg.Description)</span>
                            </td>
                            <td>
                                @if (template.FromNest)
                                {
                                    <span class="badge">@L["admin.games.fromNest"] @template.NestName</span>
                                }
                                else
                                {
                                    <span class="badge">@L["admin.games.fromPanel"]</span>
                                }
                            </td>
                            <td><code>@EggTemplate.Image(template.Egg)</code></td>
                            <td class="table__number">@EggTemplate.Variables(template.Egg).Count</td>
                            <td>
                                <div class="table__actions">
                                    @if (template.FromNest)
                                    {
                                        <span class="table__secondary">@L["admin.games.nestReadOnly"]</span>
                                    }
                                    else
                                    {
                                        <form method="post" asp-controller="Admin" asp-action="DeleteGame" asp-route-uuid="@template.Egg.Uuid" class="inline-form">
                                            <button type="submit" class="button button--ghost button--sm">@L["admin.games.delete"]</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</section>
