@model AdminGeneralViewModel
@{
    ViewData["Title"] = L["admin.general"].ToString();
    var branding = Model.Branding;
}

<section class="page">
    <header class="page__header">
        <div>
            <span class="eyebrow">@L["admin.eyebrow"]</span>
            <h1 class="page__title">@L["admin.general"]</h1>
            <p class="page__subtitle">Panel identity and the allocations servers are assigned from.</p>
        </div>
    </header>

    <partial name="_AdminTabs" />

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert--success" role="status">@success</div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert--danger" role="alert">@error</div>
    }

    <form method="post"
          asp-controller="Admin"
          asp-action="General"
          enctype="multipart/form-data"
          class="form card">
        <div class="card__header">
            <div>
                <h2 class="card__title">Panel identity</h2>
                <p class="card__subtitle">Name and logo used in the sidebar, page titles and sign-in screens.</p>
            </div>
        </div>

        <div class="admin-create__grid">
            <div class="form__group">
                <label class="form__label" for="general-name">Panel name</label>
                <input class="form__input" id="general-name" name="Name" value="@branding.Name" required maxlength="64" />
            </div>
            <div class="form__group">
                <label class="form__label" for="general-logo">Logo</label>
                <input class="form__input"
                       id="general-logo"
                       name="Logo"
                       type="file"
                       accept="image/png,image/jpeg,image/webp,image/gif,image/svg+xml,image/avif,image/jxl" />
                <span class="form__hint">PNG, JPEG, WebP, GIF, SVG, AVIF or JPEG XL up to 2 MB.</span>
            </div>
        </div>

        <div class="form__group">
            <span class="form__label">Current logo</span>
            <div class="branding-preview">
                <partial name="_BrandMark" />
                @if (branding.LogoFileName is null)
                {
                    <span class="form__hint">The bundled logo is used until you upload one.</span>
                }
            </div>
        </div>

        <div class="admin-create__checks">
            <label class="form__check">
                <input type="checkbox" name="HideSidebarLogo" value="true" checked="@branding.HideSidebarLogo" />
                Hide the logo in the sidebar
            </label>

            @if (branding.LogoFileName is not null)
            {
                <label class="form__check">
                    <input type="checkbox" name="RemoveLogo" value="true" />
                    Remove the custom logo
                </label>
            }
        </div>

        <div class="card__header card__header--spaced">
            <div>
                <h2 class="card__title">Maintenance mode</h2>
                <p class="card__subtitle">Non-administrator visitors see a maintenance page instead of the panel. Administrators keep full access.</p>
            </div>
        </div>

        <div class="admin-create__checks">
            <label class="form__check">
                <input type="checkbox" name="MaintenanceMode" value="true" checked="@branding.MaintenanceMode" />
                Enable maintenance mode
            </label>
        </div>

        <div class="form__group">
            <label class="form__label" for="general-maintenance-reason">Reason</label>
            <textarea class="form__input"
                      id="general-maintenance-reason"
                      name="MaintenanceReason"
                      rows="3"
                      maxlength="500"
                      placeholder="We are upgrading the database. Back in about 15 minutes.">@branding.MaintenanceReason</textarea>
            <span class="form__hint">Shown on the maintenance page. Leave empty for the default message.</span>
        </div>

        <div class="admin-create__actions">
            <button type="submit" class="button button--primary">Save changes</button>
        </div>
    </form>

    <section class="card">
        <div class="card__header">
            <div>
                <h2 class="card__title">Automatic allocation creation</h2>
                <p class="card__subtitle">Create single ports or ranges on a node. Servers are then assigned from these allocations.</p>
            </div>
            <span class="pill pill--muted">@Model.Allocations.Count</span>
        </div>

        @if (Model.Nodes.Count == 0)
        {
            <p class="form__hint">Create a node first; allocations belong to a node.</p>
        }
        else
        {
            <form method="post" asp-controller="Admin" asp-action="CreateAllocations" class="form">
                <div class="admin-create__grid">
                    <div class="form__group">
                        <label class="form__label" for="allocation-node">Node</label>
                        <select class="form__input" id="allocation-node" name="NodeId" required>
                            @foreach (var node in Model.Nodes)
                            {
                                <option value="@node.Id">@node.Name (@node.Fqdn)</option>
                            }
                        </select>
                    </div>
                    <div class="form__group">
                        <label class="form__label" for="allocation-ip">IP address</label>
                        <input class="form__input" id="allocation-ip" name="Ip" value="0.0.0.0" required maxlength="45" />
                    </div>
                </div>

                <div class="form__group">
                    <label class="form__label" for="allocation-ports">Ports</label>
                    <textarea class="form__input"
                              id="allocation-ports"
                              name="Ports"
                              rows="3"
                              required
                              placeholder="25565&#10;25570-25580"></textarea>
                    <span class="form__hint">One port or range per line (or separated by commas). Ranges use <code>start-end</code>.</span>
                </div>

                <div class="admin-create__actions">
                    <button type="submit" class="button button--primary">Create allocations</button>
                </div>
            </form>
        }

        @if (Model.Allocations.Count > 0)
        {
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Address</th>
                            <th>Node</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model.Allocations)
                    {
                        <tr>
                            <td><code>@row.Allocation.Ip:@row.Allocation.Port</code></td>
                            <td>@row.NodeName</td>
                            <td>
                                @if (row.Assigned)
                                {
                                    <span class="badge badge--running">Assigned</span>
                                }
                                else
                                {
                                    <span class="badge">Free</span>
                                }
                            </td>
                            <td>
                                @if (!row.Assigned)
                                {
                                    <form method="post"
                                          asp-controller="Admin"
                                          asp-action="DeleteAllocation"
                                          asp-route-id="@row.Allocation.Id"
                                          class="inline-form">
                                        <button type="submit" class="button button--ghost button--sm">Delete</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty">
                <p class="empty__title">No allocations yet</p>
                <p class="empty__hint">Create ports above, then pick one when you create a server.</p>
            </div>
        }
    </section>

    <section class="card">
        <div class="card__header">
            <div>
                <h2 class="card__title">Add-ons</h2>
                <p class="card__subtitle">Reload the add-on assemblies after replacing them. This restarts the add-ons only; the panel keeps running.</p>
            </div>
        </div>

        <form method="post" asp-controller="Admin" asp-action="ReloadAddons" class="form">
            <div class="admin-create__actions">
                <button type="submit" class="button button--primary">Reload add-ons</button>
                <span class="form__hint">Running add-ons are stopped, unloaded, then started again from their manifests.</span>
            </div>
        </form>
    </section>
</section>
