@model AdminServersViewModel
@{
    ViewData["Title"] = "Servers";
    var canCreate = Model.Nodes.Count > 0 && Model.Users.Count > 0;
}

<section class="page">
    <header class="page__header">
        <div>
            <span class="eyebrow">@L["admin.eyebrow"]</span>
            <h1 class="page__title">@L["admin.servers"]</h1>
            <p class="page__subtitle">Every server on the panel and who owns it.</p>
        </div>
    </header>

    <partial name="_AdminTabs" />

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert--success" role="status">@success</div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert--danger" role="alert">@error</div>
    }

    <details class="card admin-create" @(Model.Servers.Count == 0 && canCreate ? "open" : null)>
        <summary class="admin-create__summary">
            <span>
                <strong>Create server</strong>
                <span class="admin-create__hint">The panel creates the record and asks pats to install it.</span>
            </span>
            <span class="button button--primary button--sm">New server</span>
        </summary>
        <div class="admin-create__body">
            @if (!canCreate)
            {
                <p class="form__hint">Create a node and a user before creating a server.</p>
            }
            else
            {
                <form method="post" asp-controller="Admin" asp-action="CreateServer" class="form">
                    <div class="admin-create__grid">
                        <div class="form__group">
                            <label class="form__label" for="server-name">Name</label>
                            <input class="form__input" id="server-name" name="Name" required maxlength="64" placeholder="Survival" />
                        </div>
                        <div class="form__group">
                            <label class="form__label" for="server-node">Node</label>
                            <select class="form__input" id="server-node" name="NodeUuid" required>
                                @foreach (var node in Model.Nodes)
                                {
                                    <option value="@node.Uuid">@node.Name (@node.Fqdn)</option>
                                }
                            </select>
                        </div>
                        <div class="form__group">
                            <label class="form__label" for="server-owner">Owner</label>
                            <select class="form__input" id="server-owner" name="OwnerId" required>
                                @foreach (var user in Model.Users)
                                {
                                    <option value="@user.Id">@user.DisplayName (@user.Username)</option>
                                }
                            </select>
                        </div>
                        <div class="form__group">
                            <label class="form__label" for="server-egg">@L["admin.games.template"]</label>
                            <select class="form__input" id="server-egg" name="EggUuid">
                                <option value="">@L["admin.games.noTemplate"]</option>
                                @foreach (var template in Model.Eggs)
                                {
                                    <option value="@template.Egg.Uuid">
                                        @(template.NestName is null ? template.Egg.Name : $"{template.NestName} / {template.Egg.Name}")
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="form__group">
                            <label class="form__label" for="server-description">Description</label>
                            <input class="form__input" id="server-description" name="Description" maxlength="255" placeholder="Optional" />
                        </div>
                        <div class="form__group">
                            <label class="form__label" for="server-ip">Allocation IP</label>
                            <input class="form__input" id="server-ip" name="AllocationIp" value="0.0.0.0" required maxlength="64" />
                        </div>
                        <div class="form__group">
                            <label class="form__label" for="server-port">Allocation port</label>
                            <input class="form__input" id="server-port" name="AllocationPort" type="number" value="25565" min="1" max="65535" required />
                        </div>
                        <div class="form__group">
                            <label class="form__label" for="server-allocation">Free allocation</label>
                            <select class="form__input" id="server-allocation" name="AllocationId">
                                <option value="">Use the IP and port above</option>
                                @foreach (var allocation in Model.FreeAllocations)
                                {
                                    <option value="@allocation.Id">@allocation.Ip:@allocation.Port</option>
                                }
                            </select>
                            <span class="form__hint">Created in General → Automatic allocation creation.</span>
                        </div>
                        <div class="form__group">
                            <label class="form__label" for="server-memory">Memory (MB)</label>
                            <input class="form__input" id="server-memory" name="MemoryMb" type="number" value="1024" min="128" required />
                        </div>
                        <div class="form__group">
                            <label class="form__label" for="server-disk">Disk (MB)</label>
                            <input class="form__input" id="server-disk" name="DiskMb" type="number" value="10240" min="0" required />
                        </div>
                        <div class="form__group">
                            <label class="form__label" for="server-cpu">CPU limit (%)</label>
                            <input class="form__input" id="server-cpu" name="CpuLimitPercent" type="number" value="100" min="0" max="10000" />
                        </div>
                        <div class="form__group">
                            <label class="form__label" for="server-image">Container image</label>
                            <input class="form__input" id="server-image" name="Image" value="ghcr.io/pterodactyl/yolks:java_21" required />
                        </div>
                    </div>

                    <div class="form__group">
                        <label class="form__label" for="server-startup">Startup command</label>
                        <input class="form__input" id="server-startup" name="Startup" value="java -Xms128M -Xmx1024M -jar server.jar" />
                        <span class="form__hint">@L["admin.games.manualHint"]</span>
                    </div>

                    <div class="admin-create__actions">
                        <button type="submit" class="button button--primary">Create server</button>
                    </div>
                </form>
            }
        </div>
    </details>

    <section class="card card--flush">
        @if (Model.Servers.Count == 0)
        {
            <div class="empty">
                <p class="empty__title">No servers yet</p>
                <p class="empty__hint">Servers created on any node will be listed here.</p>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Server</th>
                            <th>Owner</th>
                            <th>Node</th>
                            <th>Status</th>
                            <th class="table__number">Memory</th>
                            <th class="table__number">Disk</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model.Servers)
                    {
                        <tr>
                            <td>
                                <span class="table__primary">@row.Server.Name</span>
                                <span class="table__secondary">@row.Server.Uuid</span>
                            </td>
                            <td>@row.OwnerName</td>
                            <td>@row.NodeName</td>
                            <td>
                                <span class="badge badge--@row.Server.Status.ToString().ToLowerInvariant()">@row.Server.Status</span>
                                @if (row.Server.Suspended)
                                {
                                    <span class="badge badge--suspended">Suspended</span>
                                }
                            </td>
                            <td class="table__number">@row.Server.MemoryLimitMb MB</td>
                            <td class="table__number">@row.Server.DiskLimitMb MB</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</section>
