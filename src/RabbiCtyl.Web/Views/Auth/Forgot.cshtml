@model ForgotPasswordViewModel
@{
    Layout = await ThemeLayouts.ResolveAsync(Context, auth: true);
    ViewData["Title"] = L["forgot.title"].ToString();
    var mailEnabled = ViewData["MailEnabled"] as bool? ?? false;
}

<section class="auth">
    <div class="auth__shell">
        <aside class="auth__aside">
            <div class="auth__aside-top">
                <partial name="_BrandMark" />
                <span class="brand__text">
                    <span class="brand__name">RabbiCtyl</span>
                    <span class="brand__sub">@L["brand.subtitle"]</span>
                </span>
            </div>

            <div class="auth__aside-copy">
                <span class="eyebrow">@L["forgot.eyebrow"]</span>
                <h1>@L["forgot.asideTitle"]</h1>
                <p>@L["forgot.asideText"]</p>
            </div>

            <span class="auth__aside-foot">RabbiCtyl panel</span>
        </aside>

        <div class="auth__form-side">
            <div class="auth__form-inner">
                <span class="eyebrow">@L["forgot.eyebrow"]</span>
                <h2 class="auth__title">@L["forgot.title"]</h2>
                <p class="auth__subtitle">@L["forgot.subtitle"]</p>

                @if (TempData["Success"] is string success)
                {
                    <div class="alert alert--success" role="status">@success</div>
                }

                @if (!mailEnabled)
                {
                    <div class="alert alert--warning" role="status">@L["forgot.mailDisabled"]</div>
                }

                <form method="post" asp-controller="Auth" asp-action="Forgot" class="form">
                    <div asp-validation-summary="ModelOnly" class="alert alert--danger"></div>

                    <div class="form__group">
                        <label asp-for="Email" class="form__label">@L["forgot.email"]</label>
                        <input asp-for="Email" class="form__input" type="email" autocomplete="email" autofocus />
                        <span asp-validation-for="Email" class="form__error"></span>
                    </div>

                    <button type="submit" class="button button--primary button--block">@L["forgot.submit"]</button>
                </form>

                <p class="auth__note">
                    <a asp-controller="Auth" asp-action="Login">@L["forgot.back"]</a>
                </p>
            </div>
        </div>
    </div>
</section>
